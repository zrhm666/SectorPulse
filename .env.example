SECTOR_PULSE_DATABASE_PATH=data/sector-pulse.db
# Optional PostgreSQL runtime; when set, it takes precedence over SQLite.
# Preferred synchronous URL: postgresql+psycopg://user:password@host:5432/database
# Legacy postgresql+asyncpg:// URLs are normalized to the synchronous psycopg driver.
SECTOR_PULSE_DATABASE_URL=
POSTGRES_DB=sectorpulse
POSTGRES_USER=sectorpulse
POSTGRES_PASSWORD=sectorpulse-local-only
SECTOR_PULSE_LLM_PROVIDER=openai-compatible
SECTOR_PULSE_LLM_BASE_URL=https://api.example.com/v1
SECTOR_PULSE_LLM_API_KEY=
SECTOR_PULSE_LLM_MODEL=
SECTOR_PULSE_LLM_TIMEOUT_SECONDS=60
SECTOR_PULSE_LLM_BUDGET_CNY=2.00
SECTOR_PULSE_LLM_MAX_ATTRIBUTION_CONCURRENCY=4
SECTOR_PULSE_LLM_MAX_REVISION_ROUNDS=2
# Disable automatic due-window dispatch without disabling manually started work.
SECTOR_PULSE_SCHEDULER_ENABLED=false
SECTOR_PULSE_SCHEDULER_POLL_SECONDS=10
SECTOR_PULSE_TASK_LEASE_SECONDS=300
SECTOR_PULSE_TASK_MAX_ATTEMPTS=3
SECTOR_PULSE_TASK_DEADLINE_SECONDS=900
SECTOR_PULSE_TASK_RETRY_BACKOFF_SECONDS=2

# --- 内部研究资料库 RAG（默认关闭）---
# 只有 SECTOR_PULSE_RAG_ENABLED=true 时才校验下面这些键；
# 关闭时现有 SQLite / PostgreSQL 流程完全不受影响。
# RAG 需要权威 PostgreSQL：开启后 SECTOR_PULSE_DATABASE_URL 必须指向 PostgreSQL，
# 指向 SQLite 会在启动时直接报错，不会静默降级。
SECTOR_PULSE_RAG_ENABLED=false

# 向量索引（派生、可重建；PostgreSQL 才是权威状态）
SECTOR_PULSE_RAG_VECTOR_PROVIDER=milvus
SECTOR_PULSE_RAG_MILVUS_URI=
SECTOR_PULSE_RAG_MILVUS_TOKEN=
SECTOR_PULSE_RAG_MILVUS_COLLECTION=internal_research_chunks_v1
# 可选：Embedding 升级时用于原子切换的 collection 别名
SECTOR_PULSE_RAG_MILVUS_ALIAS=

# 原始文件与派生资产存储（默认 MinIO，bucket 必须私有）
SECTOR_PULSE_RAG_ASSET_PROVIDER=minio
SECTOR_PULSE_RAG_MINIO_ENDPOINT=
SECTOR_PULSE_RAG_MINIO_ACCESS_KEY=
SECTOR_PULSE_RAG_MINIO_SECRET_KEY=
SECTOR_PULSE_RAG_MINIO_BUCKET=
SECTOR_PULSE_RAG_MINIO_SECURE=true
# none 表示不扫描；此时上传质量门禁会看到 NOT_SCANNED，而不是假定文件干净
SECTOR_PULSE_RAG_ASSET_SCANNER=none

# 模型 Provider；Embedding / Reranker / NLI / 事实提取为必需，OCR 与视觉解析按需
SECTOR_PULSE_RAG_EMBEDDING_PROVIDER=
SECTOR_PULSE_RAG_EMBEDDING_MODEL=
# Milvus 集合的向量维度。必须与所用 embedding 模型一致，改它等于换一个集合。
SECTOR_PULSE_RAG_EMBEDDING_DIMENSION=
SECTOR_PULSE_RAG_RERANKER_PROVIDER=
SECTOR_PULSE_RAG_RERANKER_MODEL=
SECTOR_PULSE_RAG_NLI_PROVIDER=
SECTOR_PULSE_RAG_NLI_MODEL=
SECTOR_PULSE_RAG_OCR_PROVIDER=
SECTOR_PULSE_RAG_OCR_MODEL=
SECTOR_PULSE_RAG_VISION_PROVIDER=
SECTOR_PULSE_RAG_VISION_MODEL=
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_PROVIDER=
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_MODEL=

# 保留与检索窗口
SECTOR_PULSE_RAG_RETENTION_DAYS=30
SECTOR_PULSE_RAG_DENSE_TOP_K=40
SECTOR_PULSE_RAG_BM25_TOP_K=40
SECTOR_PULSE_RAG_FUSION_TOP_K=50
SECTOR_PULSE_RAG_RERANK_TOP_K=12
SECTOR_PULSE_RAG_MAX_PARENT_EXPANSION=3

# 置信度阈值
SECTOR_PULSE_RAG_MIN_NLI_CONFIDENCE=0.7
SECTOR_PULSE_RAG_MIN_CLAIM_CONFIDENCE=0.5
SECTOR_PULSE_RAG_MIN_OCR_CONFIDENCE=0.6
SECTOR_PULSE_RAG_MIN_VISION_CONFIDENCE=0.6

# 每类 Provider 独立配置超时、重试、并发、批大小、调用上限与预算。
# 下列默认值对六个前缀同时生效：EMBEDDING / RERANKER / NLI / OCR / VISION / CLAIM_EXTRACTOR
#
# 注意：*_MAX_CALLS_PER_RUN / *_RESERVE_CNY_PER_CALL / *_DAILY_BUDGET_CNY 目前只被解析，尚未
# 参与任何决策——预算闸门 BudgetedProviderCall 还没接进生产调用路径（见实施计划 E168）。
# 在那之前，请不要把这些值当作成本上限来依赖。
SECTOR_PULSE_RAG_EMBEDDING_TIMEOUT_SECONDS=30
SECTOR_PULSE_RAG_EMBEDDING_MAX_RETRIES=2
SECTOR_PULSE_RAG_EMBEDDING_MAX_CONCURRENCY=4
SECTOR_PULSE_RAG_EMBEDDING_BATCH_SIZE=32
SECTOR_PULSE_RAG_EMBEDDING_MAX_CALLS_PER_RUN=200
SECTOR_PULSE_RAG_EMBEDDING_RESERVE_CNY_PER_CALL=0.0100
SECTOR_PULSE_RAG_EMBEDDING_DAILY_BUDGET_CNY=10.00
SECTOR_PULSE_RAG_RERANKER_TIMEOUT_SECONDS=30
SECTOR_PULSE_RAG_RERANKER_MAX_RETRIES=2
SECTOR_PULSE_RAG_RERANKER_MAX_CONCURRENCY=4
SECTOR_PULSE_RAG_RERANKER_BATCH_SIZE=32
SECTOR_PULSE_RAG_RERANKER_MAX_CALLS_PER_RUN=200
SECTOR_PULSE_RAG_RERANKER_RESERVE_CNY_PER_CALL=0.0100
SECTOR_PULSE_RAG_RERANKER_DAILY_BUDGET_CNY=10.00
SECTOR_PULSE_RAG_NLI_TIMEOUT_SECONDS=30
SECTOR_PULSE_RAG_NLI_MAX_RETRIES=2
SECTOR_PULSE_RAG_NLI_MAX_CONCURRENCY=4
SECTOR_PULSE_RAG_NLI_BATCH_SIZE=32
SECTOR_PULSE_RAG_NLI_MAX_CALLS_PER_RUN=200
SECTOR_PULSE_RAG_NLI_RESERVE_CNY_PER_CALL=0.0100
SECTOR_PULSE_RAG_NLI_DAILY_BUDGET_CNY=10.00
SECTOR_PULSE_RAG_OCR_TIMEOUT_SECONDS=30
SECTOR_PULSE_RAG_OCR_MAX_RETRIES=2
SECTOR_PULSE_RAG_OCR_MAX_CONCURRENCY=4
SECTOR_PULSE_RAG_OCR_BATCH_SIZE=32
SECTOR_PULSE_RAG_OCR_MAX_CALLS_PER_RUN=200
SECTOR_PULSE_RAG_OCR_RESERVE_CNY_PER_CALL=0.0100
SECTOR_PULSE_RAG_OCR_DAILY_BUDGET_CNY=10.00
SECTOR_PULSE_RAG_VISION_TIMEOUT_SECONDS=30
SECTOR_PULSE_RAG_VISION_MAX_RETRIES=2
SECTOR_PULSE_RAG_VISION_MAX_CONCURRENCY=4
SECTOR_PULSE_RAG_VISION_BATCH_SIZE=32
SECTOR_PULSE_RAG_VISION_MAX_CALLS_PER_RUN=200
SECTOR_PULSE_RAG_VISION_RESERVE_CNY_PER_CALL=0.0100
SECTOR_PULSE_RAG_VISION_DAILY_BUDGET_CNY=10.00
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_TIMEOUT_SECONDS=30
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_MAX_RETRIES=2
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_MAX_CONCURRENCY=4
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_BATCH_SIZE=32
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_MAX_CALLS_PER_RUN=200
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_RESERVE_CNY_PER_CALL=0.0100
SECTOR_PULSE_RAG_CLAIM_EXTRACTOR_DAILY_BUDGET_CNY=10.00
