SECTOR_PULSE_DATABASE_PATH=data/sector-pulse.db
# Optional PostgreSQL runtime; when set, it takes precedence over SQLite.
# Preferred synchronous URL: postgresql+psycopg://user:password@host:5432/database
# Legacy postgresql+asyncpg:// URLs are normalized to the synchronous psycopg driver.
SECTOR_PULSE_DATABASE_URL=
POSTGRES_DB=sectorpulse
POSTGRES_USER=sectorpulse
POSTGRES_PASSWORD=sectorpulse-local-only
SECTOR_PULSE_LLM_PROVIDER=openai-compatible
SECTOR_PULSE_LLM_BASE_URL=https://api.example.com/v1
SECTOR_PULSE_LLM_API_KEY=
SECTOR_PULSE_LLM_MODEL=
SECTOR_PULSE_LLM_TIMEOUT_SECONDS=60
SECTOR_PULSE_LLM_BUDGET_CNY=2.00
SECTOR_PULSE_LLM_MAX_ATTRIBUTION_CONCURRENCY=4
SECTOR_PULSE_LLM_MAX_REVISION_ROUNDS=2
# Disable automatic due-window dispatch without disabling manually started work.
SECTOR_PULSE_SCHEDULER_ENABLED=false
SECTOR_PULSE_SCHEDULER_POLL_SECONDS=10
SECTOR_PULSE_TASK_LEASE_SECONDS=300
SECTOR_PULSE_TASK_MAX_ATTEMPTS=3
SECTOR_PULSE_TASK_DEADLINE_SECONDS=900
SECTOR_PULSE_TASK_RETRY_BACKOFF_SECONDS=2
