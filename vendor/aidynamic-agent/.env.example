# LLM Provider Configuration
# Copy this file to .env and fill in your values

LLM_PROVIDER=openai
API_KEY=your-api-key-here
# BASE_URL=  # optional: set to a custom endpoint (e.g. vLLM, Azure)
MODEL=gpt-4o-mini

# Agent Behaviour
MAX_LOOPS=30
MAX_TOKENS=8000
TOTAL_TIMEOUT=300
TEMPERATURE=0.7

# System Prompt
SYSTEM_PROMPT=You are a helpful assistant. Use tools when needed. Think step by step.
